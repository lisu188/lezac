+void LezacReadPicClock(LezacClockObservation& result) {
+	result.pending = PIC_IRQCheck;
+	result.active = PIC_IRQActive;
+	result.active_lines = result.masked_lines = result.inservice_lines = 0;
+	for (unsigned i = 0; i < 16; ++i) {
+		if (irqs[i].active) result.active_lines |= Bitu(1) << i;
+		if (irqs[i].masked) result.masked_lines |= Bitu(1) << i;
+		if (irqs[i].inservice) result.inservice_lines |= Bitu(1) << i;
+	}
+	result.special = PIC_Special_Mode;
+	result.auto_eoi = pics[0].auto_eoi;
+	result.irq0_vector = irqs[0].vector;
+	result.queue_count = 0;
+	result.queue_overflow = false;
+	for (PICEntry* entry = pic_queue.next_entry; entry; entry = entry->next) {
+		if (result.queue_count == 64) { result.queue_overflow = true; break; }
+		auto& item = result.queue[result.queue_count++];
+		std::memcpy(&item.index_bits, &entry->index, sizeof(item.index_bits));
+		item.kind = LezacClockIsPit0(entry->pic_event) ? 1 : LezacClockVgaKind(entry->pic_event);
+		item.value = entry->value;
+	}
+}
